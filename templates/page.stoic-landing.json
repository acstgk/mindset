DLEY & STEPHEN BELL</td>\n            <td>1019</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <table class=\"stoic-table \">\n        <thead>\n          <tr>\n            <th colspan=\"3\">WOMEN'S SINGLES - TOP 5</th>\n          </tr>\n          <tr>\n            <th>POSITION</th>\n            <th>NAME</th>\n            <th>SCORE</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>1</td>\n            <td>LISA TAYLOR</td>\n            <td>670</td>\n          </tr>\n          <tr>\n            <td>2</td>\n            <td>KATIE SHELTON</td>\n            <td>667</td>\n          </tr>\n          <tr>\n            <td>3</td>\n            <td>ASHLEIGH FEARN</td>\n            <td>614</td>\n          </tr>\n          <tr>\n            <td>4</td>\n            <td>JILL AXWORTHY</td>\n            <td>537</td>\n          </tr>\n          <tr>\n            <td>5</td>\n            <td>KITTI KLEMPA</td>\n            <td>520</td>\n          </tr>\n        </tbody>\n      </table>\n\n      <table class=\"stoic-table \">\n        <thead>\n          <tr>\n            <th colspan=\"3\">WOMEN'S DOUBLES - TOP 5</th>\n          </tr>\n          <tr>\n            <th>POSITION</th>\n            <th>NAME</th>\n            <th>SCORE</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>1</td>\n            <td>VICTORIA WALLACE & KIM WORTHINGTON</td>\n            <td>884</td>\n          </tr>\n          <tr>\n            <td>2</td>\n            <td>TONI BUCKINGHAM & ALICE SMILES</td>\n            <td>845</td>\n          </tr>\n          <tr>\n            <td>3</td>\n            <td>GEORGIA LYON & MEGHAN CROSSLAND</td>\n            <td>641</td>\n          </tr>\n          <tr>\n            <td>4</td>\n            <td>LUCY GRAY & BECKY RISDON</td>\n            <td>639</td>\n          </tr>\n          <tr>\n            <td>5</td>\n            <td>LOWRI JONES & CAITLIN DUXBURY</td>\n            <td>536</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n<style>\n\n.leaderboard-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n    grid-auto-flow: dense;\n    flex-flow: row wrap;\n    gap: 30px;\n}\n\n.stoic-table {\n    width: 100%;\n    max-width: 800px;\n    margin: 30px auto;\n    border-collapse: collapse;\n    font-family: 'Montserrat', Arial, sans-serif;\n    background: white;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\n    flex: 1 1 325px;\n    text-transform: uppercase;\n}\n\n.stoic-table thead {\n    background-color: #414042;\n    color: white;\n}\n\n.stoic-table th {\n    font-family: Octin, Impact, sans-serif;\n    letter-spacing: 1px;\n    font-weight: normal;\n    padding: 15px;\n    text-align: left;\n    font-size: 1.1rem;\n}\n\n.stoic-table td {\n    padding: 12px 15px;\n   border: 1px solid #eee;\n}\n\n.stoic-table tr {\n   border: 1px solid #eee;\n}\n\n.stoic-table tbody tr:nth-child(even) {\n    background-color: #f9f9f9;\n}\n\n.stoic-table tbody tr:hover {\n    background-color: #f0f0f0;\n}\n\n.stoic-table tbody td:nth-child(1) {\n    font-weight: bold;\n    text-align: center;\n    width: 80px;\n}\n\n.stoic-table th:nth-child(1) {\n    text-align: center;\n}\n\n.stoic-table tbody td:nth-child(3) {\n    font-family: Octin, Impact, sans-serif;\n    font-size: 1.1rem;\n}\n\n.stoic-table .text-gold {\n    color: #D4AF37 !important;\n    font-weight: bold;\n}\n\n.rich-content--wrapper>* {\ngrid-area: auto;\npadding-top: 1.5em;\n}\n\n</style>"
