        "rtf_M6waCC": {
          "type": "rtf",
          "settings": {
            "richtext_content": "<p><strong>Forget racing the clock.</strong> The Last Stoic Standing is about pushing beyond your physical and mental limits. It's a test of resilience, determination and grit—to discover who keeps going when everyone else has stopped. Created by  <strong>Gym King</strong> and <strong>Ross Edgley</strong>, The Last Stoic Standing is the ultimate test of physical resilience, mental composure and relentless determination.</p><p>Inspired by the principles of Stoicism, this isn't simply a fitness event—it's a battle against fatigue, discomfort and the voice telling you to quit.</p>"
          }
        },
        "quote_mCzfgD": {
          "type": "quote",
          "disabled": true,
          "settings": {
            "quote_text": "Train only the body and you risk strength without mindset. Train only the mind and you risk wisdom without strength.",
            "quote_author": "Ross Edgley"
          }
        }
      },
