          "type": "rtf",
          "settings": {
            "richtext_content": "<h2>The Circuit</h2><p>Participants give maximum effort to accumulate points across seven disciplines, with five minutes allocated to each.</p>"
          }
        },
        "html_NbjLTC": {
          "type": "html",
          "settings": {
