        "rtf_UaFdgD": {
          "type": "rtf",
          "settings": {
            "richtext_content": "<p>Score as many points as possible within each discipline e.g. <br/>120KG deadlift = 120 points. <br/>50 press ups = 50 points. <br/>100 calories burnt = 100 points.</p><p><strong>Note:</strong> Reaching the 1,000 Club is a sign of elite all-round capacity, only 1 in 200 people have achieved elite status in trials.</p>"
          }
