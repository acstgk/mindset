        "rtf_c9TyYA": {
          "type": "rtf",
          "settings": {
            "richtext_content": "<h2>The Circuit</h2><p>The concept is simple: 5 stations. The contestant with the most points, wins. this is a one of a kind strength and resilience event. each station will continue until the last stoic is standing. Have you got what it takes to take the ultimate fitness test?</p>"
          }
        },
        "html_NbjLTC": {
          "type": "html",
          "settings": {
            "custom_html": "<div class=\"stations-list\">\n\n  <div class=\"station-list--item\">\n        <div class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/stoic-deadlift.png?v=1783940459\" alt=\"Deadlift Icon\" loading=\"lazy\">\n        </div>\n        <div class=\"station-list--item-content\">\n          <div class=\"station\">station 01.</div>\n          <div class=\"txt\">Deadlift</div>\n          <div class=\"metric\">\n            <b>Format:</b> Every minute add 10kg<br><b>Result:</b> Your                                 max. deadlift in kg = points won\n          </div>\n        </div>\n      </div>\n  <div class=\"station-list--item\">\n        <div class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/stoic-press__up.png?v=1783940459\" alt=\"Press Up\" loading=\"lazy\">\n        </div>\n        <div class=\"station-list--item-content\">\n          <div class=\"station\">station 02.</div>\n          <div class=\"txt\">Press Up</div>\n          <div class=\"metric\">\n            <b>Format:</b> 1 repetition every 3 seconds<br><b>Result:</b> Your total reps (unbroken) = points won\n          </div>\n        </div>\n      </div>\n  <div class=\"station-list--item\">\n        <div class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/stoic-bleep_test.png?v=1783940459\" alt=\"Deadlift Icon\" loading=\"lazy\">\n        </div>\n        <div class=\"station-list--item-content\">\n          <div class=\"station\">station 3.</div>\n          <div class=\"txt\">Bleep Test</div>\n          <div class=\"metric\">\n            <b>Format:</b> 20 metre track | 21 levels | 247 shuttles<br><b>Result:</b> Your total number of shuttles = points won\n          </div>\n        </div>\n      </div>\n  <div class=\"station-list--item\">\n        <div class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/stoic-dead_hang.png?v=1783940459\" alt=\"Deadlift Icon\" loading=\"lazy\">\n        </div>\n        <div class=\"station-list--item-content\">\n          <div class=\"station\">station 04.</div>\n          <div class=\"txt\">Dead Hang</div>\n          <div class=\"metric\">\n            <b>Format:</b> Hang for as long as possible  <br><b>Result:</b> Your time in seconds = points won\n          </div>\n        </div>\n      </div>\n  <div class=\"station-list--item\">\n        <div class=\"icon\">\n          <img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/stoic-the_stoic_stone.png?v=1783940459\" alt=\"Deadlift Icon\" loading=\"lazy\">\n        </div>\n        <div class=\"station-list--item-content\">\n          <div class=\"station\">station 05.</div>\n          <div class=\"txt\">The Stoic Stone</div>\n          <div class=\"metric\">\n            <b>Format:</b> Carry the stoic stone as far possible  <br><b>Result:</b> Your distance in metres = points won\n          </div>\n        </div>\n      </div>\n    </div>\n<style>\n.stations-list {\n  display: flex;\n  flex-flow: row wrap;\ngap: 2rem 0;\n  justify-content: space-around;\n  margin: 60px auto;\n}\n\n.station-list--item {\nbackground: #0E0E0E;\n    color: #F4F4F4;\n    display: flex;\n    flex-direction: row;\n    padding: 1.5rem 1.75rem 1.5rem 0.5rem;\n    gap: 0.5rem;\n    width: min(624px, 90vw);\n    padding-right: 4rem;\n    justify-content: flex-start;\n}\n\n.station-list--item .icon {\n  width: 35%;\n  height: 100%;\n  flex: 30% 0 0;\n  display: grid;\n  place-items: center;\n}\n .station-list--item .icon img {\n    height: auto;\n    width: min(50%, 70px);\n    height: min(100%, 95px);\nobject-fit: contain;\n  }\n}\n\n.station-list--item-content {\n  flex: 75% 0 0;\n  margin-right: 4rem;\n  display: grid;\n  place-content: center;\n}\n\n.station-list--item-content .station {\n  letter-spacing: 0.5ch;\n  text-transform: uppercase;\n  font-size: var(--txt-p);\nfont-family: \"Octin\", var(--emphasis-heading-font-family);\n}\n.station-list--item-content .txt {\n  font-size: var(--txt-h2);\n  margin: 0.5rem 0;\n  text-transform: uppercase;\nfont-family: \"Octin\", var(--emphasis-heading-font-family) !important;\nfont-weight: 700;\n}\n\n.station-list--item-content .metric {\n  font-size: var(--txt-sm);\nfont-family: \"Octin\", var(--emphasis-heading-font-family);\n}\n</style>"
          }
        },
