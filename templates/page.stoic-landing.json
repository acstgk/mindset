ber\">step 05</div>\n        <div class=\"station-list--item-content\">\n          <div class=\"icon\"><img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/STOIC_ICONS_ROW.svg?v=1766063285\" alt=\"Rowing\" loading=\"lazy\"></div>\n          <div class=\"txt\">Rower Erg</div>\n          <div class=\"metric\">Calories</div>\n        </div>\n      </div>\n      <div class=\"station-list--item\">\n        <div class=\"station-list--item-number\">step 06</div>\n        <div class=\"station-list--item-content\">\n          <div class=\"icon\"><img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/STOIC_ICONS_RUN.svg?v=1766063285\" alt=\"Run Icon\" loading=\"lazy\"></div>\n          <div class=\"txt\">Curved Run</div>\n          <div class=\"metric\">Calories</div>\n        </div>\n      </div>\n      <div class=\"station-list--item\">\n        <div class=\"station-list--item-number\">step 07</div>\n        <div class=\"station-list--item-content\">\n          <div class=\"icon\"><img src=\"https://cdn.shopify.com/s/files/1/1659/8997/files/STOIC_ICONS_WALL_BALL.svg?v=1766063285\" alt=\"Wall Ball Icon\" loading=\"lazy\"></div>\n          <div class=\"txt\">Wall Balls</div>\n          <div class=\"metric\">Total reps</div>\n        </div>\n      </div>\n    </div>\n<style>\n\n.stations-list {\n  display: flex;\n  flex-flow: row wrap;\n  gap: 30px;\n  justify-content: space-around;\n  margin: 60px auto;\n}\n\n.station-list--item {\n  flex: 1 0 min(475px, 100%);\n  font-family: Octin, Impact, Haettenschweiler, Arial Narrow Bold, sans-serif;\n  line-height: 1;\n}\n\n.station-list--item-number {\n    align-content: center;\n    background-color: #bab3ad;\n    border-radius: 20px;\n    color: #fff;\n    display: grid;\n    height: 20px;\n    justify-content: center;\n    margin: 0 auto;\n    padding: 1rem;\n    place-content: center;\n    position: relative;\n    text-align: center;\n    width: max-content;\n    z-index: 1;\n}\n.station-list--item-content {\n    align-items: center;\n    background-color: #414042;\n    border-radius: 80px;\n    color: #fff;\n    display: flex;\n    height: 80px;\n    justify-content: space-between;\n    margin: -10px auto 0;\n    padding: 10px 30px;\n    width: min(100%,600px);\n}\n.station-list--item-content img {\n    height: 40px;\n    -o-object-fit: contain;\n    object-fit: contain;\n    width: 40px;\n}\n.station-list--item-content .txt {\n    font-size: var(--txt-h3);\n}\n\n.station-list--item-content .metric {\n    font-size: var(--txt-sm);\n}\n</style>"
          }
