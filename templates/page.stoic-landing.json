        "rtf_REzRLJ": {
          "type": "rtf",
          "settings": {
            "richtext_content": "<p><strong>Forget racing the clock.</strong> The Last Stoic Standing is about pushing beyond your physical and mental limits. It's a test of resilience, determination and grit—to discover who keeps going when everyone else has stopped. Created by  <strong>Gym King</strong> and <strong>Ross Edgley</strong>, The Last Stoic Standing is the ultimate test of physical resilience, mental composure and relentless determination.</p><p>Inspired by the principles of Stoicism, this isn't simply a fitness event—it's a battle against fatigue, discomfort and the voice telling you to quit.</p><p>“The concept is simple: 5 stations. The contestant with the most points, wins. this is a one of a kind strength and resilience event. each station will continue until the last stoic is standing. Have you got what it takes to be crowned the last the stoic standing? click on the link for more details and get your ticket lets go!”</p>"
          }
        },
        "html_7GTBMC": {
          "type": "html",
          "settings": {
            "custom_html": "<div class=\"width:100%;min-height:40rem;\"></div>"
          }
        },
        "quote_mCzfgD": {
          "type": "quote",
          "settings": {
            "quote_text": "Train only the body and you risk strength without mindset. Train only the mind and you risk wisdom without strength.",
            "quote_author": ""
          }
        }
      },
