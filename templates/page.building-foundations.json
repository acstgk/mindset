          "settings": {
            "richtext_content": "<h2>Apply to become a building foundations partner</h2><p>Fill out the form below to be considered for becoming a Building Foundations Partner Gym.</p>"
          }
        },
        "html_F7jJYX": {
          "type": "html",
          "settings": {
            "custom_html": "<form action=\"https://formspree.io/f/xandgdjy\" method=\"POST\" style=\"margin-top:35px;width: min(100%, 600px);\" class=\"Form Form--spacingTight\">\n      <div class=\"Form__Group\">\n        <div class=\"Form__Item\">\n          <input id=\"gym[name]\" type=\"text\" class=\"Form__Input\" name=\"name\" aria-label=\"Enter your name\" placeholder=\"Your Name\" required>\n          <label for=\"gym[name]\" class=\"Form__FloatingLabel\">Your Name:</label>\n        </div>\n        <div class=\"Form__Item\">\n          <input id=\"gym[email]\" type=\"text\" class=\"Form__Input\" name=\"email\" aria-label=\"Enter your email\" placeholder=\"Your Email\" required>\n          <label for=\"gym[email]\" class=\"Form__FloatingLabel\">Your Email:</label>\n        </div>\n      </div>\n       <div class=\"Form__Group\">\n        <div class=\"Form__Item\">\n          <input id=\"gym[gym-name]\" type=\"text\" class=\"Form__Input\" name=\"Gym\" aria-label=\"Enter Gym Name\" placeholder=\"Company/Gym Name\" required>\n          <label for=\"gym[gym-name]\" class=\"Form__FloatingLabel\">Company/Gym Name</label>\n        </div>\n        <div class=\"Form__Item\">\n          <input id=\"gym[location]\" type=\"text\" class=\"Form__Input\" name=\"Location\" aria-label=\"Enter Gym Location\" placeholder=\"Location\" required>\n          <label for=\"gym[location]\" class=\"Form__FloatingLabel\">Location</label>\n        </div>\n      </div>\n      <div class=\"Form__Item\">\n        <textarea id=\"gym[message]\" type=\"text-area\" cols=\"30\" rows=\"10\" class=\"Form__Textarea\" name=\"message\" aria-label=\"Enter Gym Location\" placeholder=\"Please send an brief overview of your current business and your interest in the partnership\" required></textarea>\n        <label for=\"gym[message]\" class=\"Form__FloatingLabel\">Your Message</label>\n      </div>\n      <!-- your other form fields go here -->\n      <button type=\"submit\" style=\"margin: 0 0 0 auto;display:block\" class=\"button button-primary\">Send</button>\n    </form>"
          }
        }
