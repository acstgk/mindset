            "cta_url": ""
          }
        },
        "grid_item_QkGjVY": {
          "type": "grid-item",
          "settings": {
            "grid_order": "-1",
            "image": "shopify://shop_images/building-foundations--3-who_d0acd5ae-326f-4c63-acb9-1bc48cd37cd9.png",
            "img_style": "square",
            "image_style": "cover",
            "rtf": "<h2>Who we Support</h2><p>We back the people who put in the work.</p><p>Through Building Foundations, we work closely with our gym partners to strengthen and improve the spaces where people train, push themselves and build confidence. From established facilities to communities just starting out, we’re here to make a real difference where it matters.</p><p>Because every fitness journey starts somewhere. Our aim is to give people the environment, support and motivation to take that first step — and keep pushing long after it.</p><p><strong>Stronger gyms. Stronger communities. Stronger foundations.</strong></p>",
            "txt_color": "#ffffff",
            "text_align": "left",
            "use_html": false,
            "html": "<p>Add custom HTML content here.</p>",
            "show_quote": false,
