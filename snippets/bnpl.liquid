<bnpl-options class=" ge-hide-display-none ge-hide">
  <div class="bnpl-placement">
    <button type="button" data-bnpl="klarna" aria-label="Klarna">
      {{ 'klarna' | payment_type_svg_tag: class: 'icon icon--full-color icon--klarna' }}
    </button>
    <button type="button" data-bnpl="clearpay" aria-label="Clearpay">
      {{ 'afterpay' | payment_type_svg_tag: class: 'icon icon--full-color icon--clearpay' }}
    </button>
    <button type="button" data-bnpl="paypal" aria-label="PayPal">
      {{ 'paypal' | payment_type_svg_tag: class: 'icon icon--full-color icon--paypal' }}
    </button>
    <div>
      <b>Buy now, pay later</b> in interest free instalments.
      <small>
        UK Residency and 18+ terms apply.
        <a href="/pages/bnpl">Learn more</a>
      </small>
    </div>
  </div>
</bnpl-options>
