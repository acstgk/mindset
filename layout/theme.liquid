<!doctype html>
<html lang="{{ shop.locale }}">
  <head>
    <!-- Start of Shoplift scripts -->
    {% render 'shoplift' %}
    <!--<script type="text/javascript" src="{{ 'shoplift-test.js' | asset_url }}"></script>-->
    <!-- End of Shoplift scripts -->

    <script>
      {%- if request.page_type == 'product' -%}
        window.myCurrentProduct = {{ product | json }};
      {%- endif -%}

      {% comment %} Init gtag() {% endcomment %}
      window.dataLayer = window.dataLayer || [];
      function gtag(){
        window.dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 2000,
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);

      {% comment %} GTM Container loader {% endcomment %}
      {% comment %} (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-PT4PRKB'); {% endcomment %}
    </script>

    <meta name="facebook-domain-verification" content="n2q1ogzkqnirqe5g5ut48t1wjvzjlr">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">
    <!-- Google Verification Tag - Start -->
    <meta name="google-site-verification" content="G8SN0Tz-JOv2y75V3XHUgg8p6pyly9zBuEt3_n-ltrI" />

    <title>
      {{ page_title }}
      {% if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif %}
      {% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape | replace: "Product Details ", ""  | truncate: 150 }}">
    {% else %}
      <meta name="description" content="{{ settings.default-meta-description }}">
    {%- endif -%}

    {% render 'social-meta-tags' %}

    {% if template contains 'search' or handle contains 'basket' %}
      <meta name="robots" content="noindex">
    {% endif %}

    {% assign updated_url = canonical_url %}

    {% if canonical_url contains 'sale' and canonical_url contains 'collections' %}
    {% else %}
      {% assign ending = canonical_url | slice: -5, 5 %}
      {% assign full-ending = canonical_url | slice: -17, 17 %}
      {% if ending == '/mens' and full-ending != '/collections/mens' %}
        {% assign updated_url = canonical_url | remove: '/mens' %}
      {% endif %}
      {% assign ending = canonical_url | slice: -7, 7 %}
      {% assign full-ending = canonical_url | slice: -19, 19 %}
      {% if ending == '/womens' and full-ending != '/collections/womens' %}
        {% assign updated_url = canonical_url | remove: '/womens' %}
      {% endif %}
    {% endif %}

    <link rel="canonical" href="{{ updated_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: '96px' }}" media="(prefers-color-scheme: light)" type="image/png">
    {%- endif -%}
    {%- if settings.alt_favicon -%}
      <link rel="shortcut icon" href="{{ settings.alt_favicon | image_url: width: '96px' }}" media="(prefers-color-scheme: dark)" type="image/png">
    {%- endif -%}

    {% render 'css-variables' %}
    <link rel="preload" as="font" type="font/woff2" href="{{ 'font-regular.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'font-condensed.woff2' | asset_url }}" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% if template contains 'product' and product.images.first %}
      <link rel="preload" as="image" href="{{ product.images.first | image_url: width: 600 }}" fetchpriority="high">
    {% endif %}
    <!-- <link rel="stylesheet" href="{{ 'critical.min.css' | asset_url }}"> -->
    <style id="critical-css">
      {% render 'critical.css' %}
    </style>
    <link rel="preload" href="{{ 'splide-core.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="{{ 'global.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="{{ 'line-items.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'global.min.css' | asset_url }}"></noscript>
    <noscript><link rel="stylesheet" href="{{ 'line-items.min.css' | asset_url }}"></noscript>
    <noscript><link rel="stylesheet" href="{{ 'fallback.min.css' | asset_url }}"></noscript>

    {{ content_for_header }}
    {% render 'rich-structured-data' %}
    <script>
      window.thirdPartyInitialized = false;

      window.initTracking = function () {
        if (window.thirdPartyInitialized) return;
        window.thirdPartyInitialized = true;

        var gtm = document.createElement('script');
        gtm.async = true;
        gtm.fetchPriority = 'low';
        gtm.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PT4PRKB';
        document.head.appendChild(gtm);

        document.dispatchEvent(new CustomEvent('third-party:init'));
      };

      if ('PerformanceObserver' in window) {
        var lcpObserver = new PerformanceObserver(function (list) {
          var entries = list.getEntries();
          if (entries.length > 0) {
            window.initTracking();
            lcpObserver.disconnect();
          }
        });
        lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
        setTimeout(window.initTracking, 10000);
      } else {
        window.addEventListener('load', window.initTracking);
      }
    </script>

    {% if request.page_type == 'index' %}
      <script>
        (function () {
          function sectionIdFrom(el) {
            while (el) {
              var id = el.id || '';
              if (id.indexOf('shopify-section-') === 0) {
                return id.replace(/^shopify-section-/i, '');
              }
              el = el.parentElement;
            }
            return null;
          }

          window.addEventListener('load', function () {
            document.addEventListener(
              'click',
              function (e) {
                var sectionId = sectionIdFrom(e.target);
                if (!sectionId) return;
                gtag('event', 'section_click', { section_id: sectionId });
              },
              true
            );
          });
        })();
      </script>
    {% endif %}

    {% if template.name contains 'product' %}
      <link rel="preload" href="{{ 'pdp.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
      <noscript><link rel="stylesheet" href="{{ 'pdp.min.css' | asset_url }}"></noscript>
    {% elsif template.name contains 'collection' or template.name contains 'search' %}
      <link rel="preload" href="{{ 'plp.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
      <noscript><link rel="stylesheet" href="{{ 'plp.min.css' | asset_url }}"></noscript>
    {% endif %}
    {% render 'speculation-rules' %}

    {% if request.page_type == "index" %}
    <style>
    .yotpo-widget-spotlight-cta {
      width: min(1400px, 100%);
      margin: 0 auto;
    }

    .yotpo-widget-loyalty-floater-widget.yotpo-widget-override-css {
        display: none;
    }

    #shopify-section-template--29714902286719__17854181664835405e {
      display: block;
    }
    </style>
    {% endif %}
  </head>

  <body class="{%- if template.directory -%}template-{{ template.directory | handle }}{%- endif -%} template-{{ template.name | handle }}">
    <a class="visually-hidden" href="#main" aria-label="skip to content">{{ 'header.navigation.skip_to_content' | t }}</a>
    <page-overlay aria-disabled></page-overlay>

    {% section 'header-main' %}
    {% section 'drawer-nav' %}
    {% section 'header-announcement' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer-main' %}

    {% unless request.page_type == 'cart' %}
      {% section 'drawer-cart' %}
    {% endunless %}

    {% render 'js-variables' %}

    <!-- Start cookieyes banner -->
    <script id="cookieyes-common" src="https://cdn-cookieyes.com/common/shopify.js" defer></script>
    <script id="cookieyes" src="https://cdn-cookieyes.com/client_data/4de0c88d0702179aeeec9765/script.js" defer></script>
    <!-- End cookieyes banner -->

    <link rel="prefetch" href="{{ 'splide.min.js' | asset_url }}" as="script" crossorigin="anonymous">
    <link rel="prefetch" href="{{ 'HeroCarousel.js' | asset_url }}" as="script" crossorigin="anonymous">
    <link rel="modulepreload" href="{{ 'main.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'ContentAccordian.js' | asset_url }}">
    <script type="module" src="{{ 'main.js' | asset_url }}" defer></script>
    {% if template contains 'product' %}
      <script type="module" src="{{ 'main-pdp.js' | asset_url }}" defer></script>
    {% endif %}
    {% if template contains 'collection' or template contains 'search' %}
      <script type="module" src="{{ 'main-plp.js' | asset_url }}" defer></script>
    {% endif %}
    {%- if template == 'customers/addresses' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
      <script src="{{ 'customer_area.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" defer></script>

    <!-- included iwish_v2 with footer my added---------- -->
    <script>
      document.addEventListener('third-party:init', function () {
        var tasks = [
          function () { {% render 'tracking-clarity' %} },
          function () { {% render 'tracking-criteo' %} },
          function () { {% render 'tracking-adroll', customer: customer %} },
          function () { {% render 'tracking-omteria' %} },
          function () { {% render 'tracking-adscale' %} },
          function () { {% render 'tracking-ometria', cart: cart %} },
          function () { {% render 'tracking-taggstar' %} },
        ];
        function next() {
          if (tasks.length === 0) return;
          tasks.shift()();
          if (tasks.length > 0) {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(next, { timeout: 3000 });
            } else {
              setTimeout(next, 300);
            }
          }
        }
        next();
      });
      if (window.thirdPartyInitialized) {
        document.dispatchEvent(new CustomEvent('third-party:init'));
      }
    </script>

    {% section 'wishlist-app-settings' %}
    {% render 'wishlist-app-links', linkType: 'footer-script' %}

    <!-- Begin Shopify-Clearpay / klarna JavaScript Snippet (v1.0.9) -->
    {% if template.name == 'product' or template.name == 'cart' %}
      <script>
        window.variantnaThemeGlobals={};
        {%case template.name%}
        {% when "product" %}
          {% if product.first_available_variant.price %}
            window.variantnaThemeGlobals.data_purchase_amount = {{ product.first_available_variant.price }};
          {% endif %}
          window.variantnaThemeGlobals.productVariants={{product.variants|json}};
          window.variantnaThemeGlobals.documentCopy=document.cloneNode(true);
        {% when "cart" %}
          window.variantnaThemeGlobals.data_purchase_amount={{cart.total_price}};
          window.variantnaThemeGlobals.documentCopy=document.cloneNode(true);
          {%endcase%}
      </script>
    {% endif %}

    <!-- Google Tag Manager (noscript) -->
    <iframe
      src="https://www.googletagmanager.com/ns.html?id=GTM-PT4PRKB"
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    ></iframe>
    <!-- End Google Tag Manager (noscript) -->

    {% if request.path contains 'help' %}
      <script src="//eu.fw-cdn.com/12832973/808139.js" chat="true" defer></script>
    {% else %}
      <style>
        #fc_frame {
          display: none;
          visibility: hidden;
        }
      </style>
    {% endif %}

    {% if template.name contains 'product' %}
      <style>
        .yotpo-widget-loyalty-floater-widget.yotpo-widget-override-css {
          display: none !important;
        }
      </style>
    {% endif %}



    {% render 'globale-js' %}
    {%- render 'country-switcher-global' -%}

    {% if request.design_mode %}
      <script src="{{ 'designmode.js' | asset_url }}" defer></script>
    {% endif %}

    <script>
      (function () {
        var webSdkScript = document.createElement('script');

        // fetch the latest 2.x.x version of the Web-SDK from the CDN
        webSdkScript.src = 'https://unpkg.com/@grafana/faro-web-sdk@2/dist/bundle/faro-web-sdk.iife.js';

        webSdkScript.onload = () => {
          window.GrafanaFaroWebSdk.initializeFaro({
            url: 'https://faro-collector-prod-gb-south-1.grafana.net/collect/6fe7b0184973485c0016658e45f5295e',
            app: {
              name: 'GymKing',
              version: '1.0.0',
              environment: 'production',
            },
          });

          // Load instrumentations at the onLoad event of the web-SDK and after the above configuration.
          // This is important because we need to ensure that the Web-SDK has been loaded and initialized before we add further instruments!
          var webTracingScript = document.createElement('script');

          // fetch the latest 2.x.x version of the Web Tracing package from the CDN
          webTracingScript.src = 'https://unpkg.com/@grafana/faro-web-tracing@2/dist/bundle/faro-web-tracing.iife.js';

          // Initialize, configure (if necessary) and add the the new instrumentation to the already loaded and configured Web-SDK.
          webTracingScript.onload = () => {
            window.GrafanaFaroWebSdk.faro.instrumentations.add(new window.GrafanaFaroWebTracing.TracingInstrumentation());
          };

          // Append the Web Tracing script script tag to the HTML page
          document.head.appendChild(webTracingScript);
        };

        // Append the Web-SDK script script tag to the HTML page
        document.head.appendChild(webSdkScript);
      })();
    </script>
  </body>
</html>
