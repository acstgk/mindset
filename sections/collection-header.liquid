<div class="collection-heading">
  <div class="no-block-margin">
    <h1>{{ collection.title }}</h1>
    {% if collection.products_count > 0 %}
      <p>
        <span class="product-count">{{ collection.products_count }}</span> products
      </p>
    {% endif %}
  </div>
  <div class="rtf full-width collection-blurb no-animation">{{ collection.description }}</div>
</div>

{% if collection.all_types.size > 2 %}
  <product-types class="product_type-bar">
    {%- for filter in collection.filters -%}
      {% assign target_filter = 'Product Type' %}
      {% if request.path contains '/all-mens-t-shirts' %}
        {% assign target_filter = 'Features' %}
      {% endif %}
      <a>{{ request.path }}</a>
      {% if filter.label == target_filter %}
        {% assign sorted_values = filter.values | sort: 'count' | reverse %}
        {% for option in sorted_values %}
          {% if target_filter == 'Product Type' or option.label contains 'Fit' %}
            {% if option.count > 0 %}
              <a
                class="splide__slide"
                {% if option.active %}
                  href="{{ collection.url }}"
                  style="font-weight:700"
                {% else %}
                  href="{{ collection.url }}?{{ option.param_name }}={{ option.label }}"
                  data-param-name="{{ option.param_name }}" data-param-label="{{ option.label }}"
                {% endif %}
              >
                {{ option.label -}}
                <i>({{ option.count }})</i>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  </product-types>
{% endif %}

{% schema %}
{
  "name": "Collection Header",
  "class": "section--collection-header max-width",
  "settings": []
}
{% endschema %}
