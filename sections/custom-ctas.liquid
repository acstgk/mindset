{% if section.settings.title %}
  <{{ section.settings.heading_size }}>{{ section.settings.title }}</{{ section.settings.heading_size }}>
{% endif %}

<div
  class="cta-wrapper"
  style="text-align: center; padding: 30px 20px;display: flex;gap: 10px;justify-content: center;flex-flow:wrap;"
>
  {% for block in section.blocks %}
    <a href="{{ block.settings.button_link }}" class="{{ section.settings.size }} button {%if block.settings.btn_color == true %}button-secondary{% else %}button-primary{% endif %}">
      {{ block.settings.btn_text }}
    </a>
  {% endfor %}
</div>

{% if block.settings.btn_color %}
  <style>
    .Button-container {
      background: #1b1b1b;
    }
    .Button-container > .Button--white {
      color: #1b1b1b !important;
    }
    .Button-container::before {
      background-color: white !important ;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "CTA Button",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "label": "H1", "value": "h1" },
        { "label": "H2", "value": "h2" },
        { "label": "H3", "value": "h3" },
        { "label": "H4", "value": "h4" }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.title != ''}}"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading Style",
      "options": [
        { "value": "", "label": "Normal" },
        { "label": "Emphasis", "value": "emphasis" },
        { "label": "Baskerville", "value": "baskerville" },
        { "label": "Signature", "value": "signature" }
      ],
      "default": "emphasis",
      "visible_if": "{{ section.settings.title != ''}}"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Font Size",
      "options": [
        { "label": "Standard", "value": "" },
        { "label": "Large", "value": "h4" },
        { "label": "Extra Large", "value": "h3" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "name": "button",
      "type": "button",
      "settings": [
        {
          "type": "header",
          "content": "CTA Button"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "btn_color",
          "label": "White button?",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom CTA Buttons",
      "category": "Content",
      "blocks": {
        "button_zNnHKn": {
          "type": "button",
          "settings": {
            "btn_text": "CTA ONE",
            "button_link": "",
            "btn_color": false
          }
        },
        "button_GawFDY": {
          "type": "button",
          "settings": {
            "btn_text": "CTA Two",
            "button_link": "",
            "btn_color": true
          }
        }
      },
      "block_order": ["button_zNnHKn", "button_GawFDY"]
    }
  ]
}
{% endschema %}
